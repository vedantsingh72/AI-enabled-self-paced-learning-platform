PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/mannmitra
CLIENT_URL=http://localhost:5173

JWT_SECRET=change-me-in-production
ENCRYPTION_KEY=change-this-32-byte-secret-key!!

# Groq — PCM doubt tutor (POST /api/learning/pcm-doubt) and direct LLM fallback for POST /api/chat when MHH_CHATBOT_URL is down
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_API_URL=https://api.groq.com/openai/v1

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
MAIN_ADMIN_SIGNUP_KEY=main-admin-key
MAIN_ADMIN_EMAIL=admin@mannmitra.com
MAIN_ADMIN_PASSWORD=admin123

# FastAPI chatbot (uses Groq) — primary for /api/chat and /api/mhh/chatbot/*
MHH_CHATBOT_URL=http://127.0.0.1:8000

# Hugging Face Inference API (router) — same models as ../mental_health_risk_api/app/hf_client.py
# Runs on each Talk mate user line and each PCM doubt tutor question; powers risk dashboard HF columns.
# https://huggingface.co/settings/tokens
HF_TOKEN=
